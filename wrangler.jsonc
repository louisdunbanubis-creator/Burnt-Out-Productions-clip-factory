{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "burnt-out-productions-clip-factory",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/sw.js",
      "/manifest.json",
      "/app-icon-192.png",
      "/app-icon-512.png",
      "/apple-touch-icon.png",
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "VIDEO_BUCKET",
      "bucket_name": "clip-factory-videos"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}