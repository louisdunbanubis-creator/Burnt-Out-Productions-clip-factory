{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "burnt-out-productions-clip-factory",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
